  float rowOff = mod(rowApprox, 2.0) * uGrid.z * 0.5;
  float colApprox = floor((local.x - rowOff) / max(uGrid.z, 0.0001) + 0.5);
  vec4 background = vec4(uBackground.rgb * uBackground.a, uBackground.a);
  vec4 slat = vec4(0.0);

