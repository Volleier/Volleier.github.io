      // Helper function to create programs
      function createProg(vs: string, fs: string, label: string) {
        const v = gl!.createShader(gl!.VERTEX_SHADER)!;
        gl!.shaderSource(v, vs.trim());
        gl!.compileShader(v);
        if (!gl!.getShaderParameter(v, gl!.COMPILE_STATUS)) {
          console.error(`[SlatOcean] ${label} vertex compile failed:`, gl!.getShaderInfoLog(v));
        }
