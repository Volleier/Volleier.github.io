  p = abs(p);
  p -= 2.0 * min(dot(k.xy, p), 0.0) * k.xy;
  p -= vec2(clamp(p.x, -k.z * r, k.z * r), r);
  return length(p) * sign(p.y);
}

float sdHexPointy(vec2 p, float outerR) {
  float apothem = outerR * 0.866025404;
  return sdHexFlat(p.yx, apothem);
}

vec2 hexCenter(float col, float row) {
  return uOrigin + vec2(col * uGrid.z + mod(row, 2.0) * uGrid.z * 0.5, row * uGrid.w);
