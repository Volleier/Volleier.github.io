    for (int dx = -1; dx <= 1; dx++) {
      float ncol = colApprox + float(dx);
      float nrow = rowApprox + float(dy);
      if (ncol < 0.0 || nrow < 0.0 || ncol >= uGrid.x || nrow >= uGrid.y) continue;
      vec4 field = texelFetch(tField, ivec2(int(ncol), int(uGrid.y - 1.0 - nrow)), 0);
