        lastFrameTime = performance.now();
        animFrameId = requestAnimationFrame(renderLoop);
      }

      function renderLoop(now: number) {
        animFrameId = 0;
        const staticOnly = needsStaticFrame && !shouldAnimate();
        needsStaticFrame = false;

        if (!shouldAnimate() && !staticOnly) return;

        const rawDt = staticOnly
          ? 0
          : Math.min(0.05, Math.max(0, (now - lastFrameTime) * 0.001));
        lastFrameTime = now;

        syncThemeColors();

        accumTime += rawDt * props.speed;
        if (reducedMotion || staticOnly) {
          introProgress = 1;
        } else {
          introProgress = props.intro
            ? introProgress + rawDt / Math.max(0.2, props.introDuration)
            : 1;
        }

        const tIntro = Math.min(introProgress, 1);
        const easedIntro =
          tIntro < 0.5 ? 4 * tIntro * tIntro * tIntro : 1 - Math.pow(-2 * tIntro + 2, 3) / 2;

        // Process pointer splats
        if (!staticOnly && fluid && splatQueue.length > 0) {
          const radius = Math.pow(di(props.cursorSize, 4, 600) / kt, 2) * 0.35;
          const aspect = Ze / kt;
          for (const [u, v, dx, dy, seed] of splatQueue) {
            if (seed === null) {
              splat(fluid.velocity, [u, v], [dx * nv, dy * nv, 0], radius);
              splat(fluid.ink, [u, v], [0.13, 0, 0], radius);
              if (wordTex) {
                const moved = Math.hypot(dx, dy);
                splat(fluid.scatter, [u, v], [dx * 4, dy * 4, Math.min(0.5, moved * 25)], radius * 1.6);
                lastScatterAt = now;
                scatterActive = true;
              }
              continue;
            }
            if (wordTex) {
              const ringR = Math.sqrt(radius) * 1.2;
              for (let i = 0; i < 6; i++) {
                const ang = seed + (i / 6) * Math.PI * 2;
                const cosA = Math.cos(ang);
                const sinA = Math.sin(ang);
                splat(fluid.scatter, [u + (cosA * ringR) / aspect, v + sinA * ringR], [cosA * 0.05, sinA * 0.05, 0.6], radius * 1.2);
              }
              lastScatterAt = now;
              scatterActive = true;
            }
            const burstRadius = radius * 0.55;
            const burstDist = Math.sqrt(burstRadius * 0.5) * 1.9;
            const burstForce = nv * 0.08;
            for (let i = 0; i < _T; i++) {
              const ang = seed + (i / _T) * Math.PI * 2;
              const cosA = Math.cos(ang);
              const sinA = Math.sin(ang);
              const pt: [number, number] = [u + (cosA * burstDist) / aspect, v + sinA * burstDist];
              const vel: [number, number, number] = [
                (cosA - sinA) * Math.SQRT1_2 * burstForce,
                (sinA + cosA) * Math.SQRT1_2 * burstForce,
                0,
              ];
              splat(fluid.velocity, pt, vel, burstRadius);
              splat(fluid.ink, pt, [0.75, 0, 0], burstRadius);
            }
            splat(fluid.ink, [u, v], [0.45, 0, 0], radius);
          }
          splatQueue.length = 0;
          hasFluidActivity = true;
        }

        const isFluidActive = fluid !== null && now < activeUntil;
        if (fluid) {
          if (isFluidActive) {
            db(Math.min(Math.max(rawDt, 1 / 240), 1 / 30));
          } else if (hasFluidActivity) {
            clearFluid();
            hasFluidActivity = false;
          }
          if (scatterActive && !staticOnly) {
            const idle = now - lastScatterAt;
            if (idle > 8000) {
              clearTarget(fluid.scatter);
              scatterActive = false;
            } else {
              const sdt = Math.min(Math.max(rawDt, 1 / 240), 1 / 30);
              gl!.bindFramebuffer(gl!.FRAMEBUFFER, fluid.scatter.write().fbo);
              gl!.viewport(0, 0, fluid.width, fluid.height);
              gl!.useProgram(pScatter);
              gl!.activeTexture(gl!.TEXTURE0);
              gl!.bindTexture(gl!.TEXTURE_2D, fluid.velocity.read().tex);
              gl!.uniform1i(gl!.getUniformLocation(pScatter, 'uVelocity'), 0);
              gl!.activeTexture(gl!.TEXTURE1);
              gl!.bindTexture(gl!.TEXTURE_2D, fluid.scatter.read().tex);
              gl!.uniform1i(gl!.getUniformLocation(pScatter, 'uSource'), 1);
              gl!.uniform2f(gl!.getUniformLocation(pScatter, 'uTexel'), 1 / fluid.width, 1 / fluid.height);
              gl!.uniform1f(gl!.getUniformLocation(pScatter, 'uDt'), sdt);
              // Hold scattered briefly, then reassemble
              gl!.uniform1f(gl!.getUniformLocation(pScatter, 'uDecay'), idle < 200 ? 0.5 : 5.0);
              drawTriangle(pScatter);
              fluid.scatter.swap();
            }
          }
        }

        const gridInfo = kh();

        // 1. Field Shader Pass
        gl!.bindFramebuffer(gl!.FRAMEBUFFER, fieldTexFBO!.fbo);
        gl!.viewport(0, 0, gridInfo.grid[0], gridInfo.grid[1]);
        gl!.useProgram(pField);

        gl!.uniform2f(gl!.getUniformLocation(pField, 'uSize'), Ze, kt);
        gl!.uniform4f(gl!.getUniformLocation(pField, 'uGrid'), gridInfo.grid[0], gridInfo.grid[1], gridInfo.grid[2], gridInfo.grid[3]);
        gl!.uniform2f(gl!.getUniformLocation(pField, 'uOrigin'), gridInfo.origin[0], gridInfo.origin[1]);
        gl!.uniform2f(gl!.getUniformLocation(pField, 'uSlat'), gridInfo.slatW, gridInfo.slatH);
        gl!.uniform1f(gl!.getUniformLocation(pField, 'uTime'), accumTime);
        gl!.uniform1f(gl!.getUniformLocation(pField, 'uScale'), props.scale);
        gl!.uniform1f(gl!.getUniformLocation(pField, 'uDirection'), (props.direction * Math.PI) / 180);
        gl!.uniform1f(gl!.getUniformLocation(pField, 'uChop'), di(props.chop, 0, 1.5));
        gl!.uniform1f(gl!.getUniformLocation(pField, 'uStretch'), di(props.stretch, 0, 0.95));
        gl!.uniform1f(gl!.getUniformLocation(pField, 'uGlint'), Math.max(0, props.glint));
        gl!.uniform1f(gl!.getUniformLocation(pField, 'uContrast'), di(props.contrast, 0.2, 4));
        gl!.uniform1f(gl!.getUniformLocation(pField, 'uPerspective'), di(props.perspective, 0, 1));
        gl!.uniform1f(gl!.getUniformLocation(pField, 'uFog'), di(props.fog, 0, 1));
        gl!.uniform1f(gl!.getUniformLocation(pField, 'uIntro'), easedIntro);
        gl!.uniform1f(gl!.getUniformLocation(pField, 'uFluid'), isFluidActive ? 1 : 0);

        const wordOn = !!(props.logoText && wordTex);

        gl!.activeTexture(gl!.TEXTURE0);
        gl!.bindTexture(gl!.TEXTURE_2D, fluid ? fluid.velocity.read().tex : null);
        gl!.uniform1i(gl!.getUniformLocation(pField, 'tVelocity'), 0);

        gl!.activeTexture(gl!.TEXTURE1);
        gl!.bindTexture(gl!.TEXTURE_2D, fluid ? fluid.ink.read().tex : null);
        gl!.uniform1i(gl!.getUniformLocation(pField, 'tInk'), 1);

        gl!.activeTexture(gl!.TEXTURE2);
        gl!.bindTexture(gl!.TEXTURE_2D, wordTex);
        gl!.uniform1i(gl!.getUniformLocation(pField, 'tLogo'), 2);

        gl!.activeTexture(gl!.TEXTURE3);
        gl!.bindTexture(gl!.TEXTURE_2D, fluid ? fluid.scatter.read().tex : null);
        gl!.uniform1i(gl!.getUniformLocation(pField, 'tScatter'), 3);
        gl!.uniform1f(gl!.getUniformLocation(pField, 'uScatter'), fluid && scatterActive ? 1 : 0);
        gl!.uniform1f(gl!.getUniformLocation(pField, 'uLogo'), wordOn ? 1 : 0);
        const wordBoxW = Math.min(Ze * 1.05, kt * 2.4) * props.logoScale;
        const wordBoxH = wordBoxW / wordAspect;
        gl!.uniform2f(gl!.getUniformLocation(pField, 'uLogoBox'), wordBoxW, wordBoxH);
        const barW = wordBoxW * props.barWidth;
        const barY = kt * 0.5 + wordBoxH * 0.28 + gridInfo.grid[3] * 2.5;
        gl!.uniform1f(gl!.getUniformLocation(pField, 'uProgress'), props.progress);
        gl!.uniform4f(
          gl!.getUniformLocation(pField, 'uBar'),
          Ze * 0.5,
          barY,
          barW * 0.5,
          gridInfo.grid[3] * 1.15
        );
        gl!.uniform1f(gl!.getUniformLocation(pField, 'uOutro'), props.outro);

        gl!.uniform2f(gl!.getUniformLocation(pField, 'uFluidTexel'), fluid ? 1 / fluid.width : 1, fluid ? 1 / fluid.height : 1);
        gl!.uniform1f(gl!.getUniformLocation(pField, 'uInk'), di(props.cursorStrength, 0, 3));
        gl!.uniform1f(gl!.getUniformLocation(pField, 'uLean'), di(props.lean, 0, 1));

        drawTriangle(pField);

        // 2. Render Shader Pass (To Screen)
        gl!.bindFramebuffer(gl!.FRAMEBUFFER, null);
        gl!.viewport(0, 0, canvas.width, canvas.height);
        gl!.useProgram(pRender);

        gl!.activeTexture(gl!.TEXTURE0);
        gl!.bindTexture(gl!.TEXTURE_2D, fieldTexFBO!.tex);
        gl!.uniform1i(gl!.getUniformLocation(pRender, 'tField'), 0);

        gl!.uniform2f(gl!.getUniformLocation(pRender, 'uSize'), Ze, kt);
        gl!.uniform1f(gl!.getUniformLocation(pRender, 'uDpr'), dpr);
        gl!.uniform4f(gl!.getUniformLocation(pRender, 'uGrid'), gridInfo.grid[0], gridInfo.grid[1], gridInfo.grid[2], gridInfo.grid[3]);
        gl!.uniform2f(gl!.getUniformLocation(pRender, 'uOrigin'), gridInfo.origin[0], gridInfo.origin[1]);
        gl!.uniform2f(gl!.getUniformLocation(pRender, 'uSlat'), gridInfo.slatW, gridInfo.slatH);
        gl!.uniform1f(gl!.getUniformLocation(pRender, 'uRound'), di(props.roundness, 0, 1));
        gl!.uniform1f(gl!.getUniformLocation(pRender, 'uTilt'), !wordOn && isFluidActive && props.lean > 0 ? gridInfo.tilt : 0);
        gl!.uniform1f(gl!.getUniformLocation(pRender, 'uLogo'), wordOn ? 1 : 0);
        gl!.uniform3f(gl!.getUniformLocation(pRender, 'uColor'), props.color[0], props.color[1], props.color[2]);
        gl!.uniform3f(gl!.getUniformLocation(pRender, 'uGlintColor'), props.glintColor[0], props.glintColor[1], props.glintColor[2]);
        gl!.uniform3f(gl!.getUniformLocation(pRender, 'uWordColor'), props.logoColor[0], props.logoColor[1], props.logoColor[2]);
        gl!.uniform4f(gl!.getUniformLocation(pRender, 'uBackground'), props.backgroundColor[0], props.backgroundColor[1], props.backgroundColor[2], props.backgroundColor[3]);

        drawTriangle(pRender);

        if (shouldAnimate()) scheduleFrame();
      }

      function resize() {
        Ze = Math.max(1, container.clientWidth);
        kt = Math.max(1, container.clientHeight);
        dpr = Math.min(window.devicePixelRatio || 1, 2, Math.sqrt(W0e / (Ze * kt)));

        const targetW = Math.round(Ze * dpr);
        const targetH = Math.round(kt * dpr);
        if (canvas.width !== targetW || canvas.height !== targetH) {
          canvas.width = targetW;
          canvas.height = targetH;
        }

        resizeFluid();
        if (!shouldAnimate()) {
          needsStaticFrame = true;
          scheduleFrame();
        }
      }

      const resizeObserver = new ResizeObserver(resize);
      resizeObserver.observe(container);
      resize();
      syncThemeColors();

      const intersectionObserver = new IntersectionObserver(
        (entries) => {
          offscreen = !entries.some((entry) => entry.isIntersecting);
          if (shouldAnimate()) scheduleFrame();
          else if (!offscreen) {
            needsStaticFrame = true;
            scheduleFrame();
          }
        },
        { root: null, threshold: 0.01 }
      );
      intersectionObserver.observe(container);

      const onVisibility = () => {
        if (shouldAnimate()) scheduleFrame();
      };
      document.addEventListener('visibilitychange', onVisibility);

      const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
      const onMotionChange = (event: MediaQueryListEvent | MediaQueryList) => {
        reducedMotion = event.matches;
        if (reducedMotion) {
          needsStaticFrame = true;
          scheduleFrame();
        } else {
          scheduleFrame();
        }
      };
      if (typeof motionQuery.addEventListener === 'function') {
        motionQuery.addEventListener('change', onMotionChange);
      } else {
        motionQuery.addListener(onMotionChange as any);
      }

      const themeQuery = window.matchMedia('(prefers-color-scheme: dark)');
      const onThemeChange = () => {
        syncThemeColors();
        needsStaticFrame = true;
        scheduleFrame();
      };
      if (typeof themeQuery.addEventListener === 'function') {
        themeQuery.addEventListener('change', onThemeChange);
      } else {
        themeQuery.addListener(onThemeChange as any);
      }

      const pauseObserver = new MutationObserver(() => {
        forcePaused = container.dataset.paused === 'true';
        if (shouldAnimate()) scheduleFrame();
        else {
          needsStaticFrame = true;
          scheduleFrame();
        }
      });
      pauseObserver.observe(container, { attributes: true, attributeFilter: ['data-paused'] });

      // Trigger initial disturbance
      setTimeout(() => {
        if (props.interactive && !reducedMotion) ti(0.5, 0.5, 0.08, -0.04, null);
      }, 50);

      if (reducedMotion) {
        needsStaticFrame = true;
      }
      scheduleFrame();

      // Live control surface for loading-screen debug panel (and tests).
      (canvas as any)._zV = {
        props,
        apply(partial: Record<string, unknown>) {
          const next = { ...partial };
          if (typeof next.color === 'string') next.color = iv(next.color, props.color);
          if (typeof next.glintColor === 'string') next.glintColor = iv(next.glintColor, props.glintColor);
          if (typeof next.backgroundColor === 'string') {
            next.backgroundColor = iv(next.backgroundColor, props.backgroundColor);
          }
          if (typeof next.preset === 'string' && BT[next.preset as string]) {
            const base = BT[next.preset as string];
            Object.assign(props, {
              scale: base.scale,
              speed: base.speed,
              direction: base.direction,
              chop: base.chop,
              stretch: base.stretch,
              glint: base.glint,
              contrast: base.contrast,
              perspective: base.perspective,
              fog: base.fog,
            });
            props.preset = next.preset as string;
            delete next.preset;
          }
          Object.assign(props, next);
          if ('interactive' in partial) resizeFluid();
          if ('followTheme' in partial) {
            container.dataset.followTheme = props.followTheme ? 'true' : 'false';
            syncThemeColors();
          }
          needsStaticFrame = true;
          scheduleFrame();
          return { ...props };
        },
        getSnapshot() {
          return { ...props };
        },
      };
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSlatOceanExact);
  } else {
    initSlatOceanExact();
  }
</script>
