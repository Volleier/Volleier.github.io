---
// SlatOceanEffect.astro - Exact 1:1 reproduction of the zV React Component from Right Code
interface Props {
  zIndex?: number;
  preset?: 'swell' | 'tide' | 'storm' | 'signal';
  color?: string;
  glintColor?: string;
  backgroundColor?: string;
  scale?: number;
  speed?: number;
  direction?: number;
  chop?: number;
  stretch?: number;
  glint?: number;
  contrast?: number;
  perspective?: number;
  fog?: number;
  slatWidth?: number;
  slatHeight?: number;
  gap?: number;
  roundness?: number;
  interactive?: boolean;
  cursorStrength?: number;
  cursorSize?: number;
  swirl?: number;
  trail?: number;
  lean?: number;
  intro?: boolean;
  introDuration?: number;
  /** When true, color/glint follow --slat-ocean-* CSS vars (light/dark). */
  followTheme?: boolean;
  /** External pause switch (also pauses when offscreen / hidden / reduced-motion). */
  paused?: boolean;
  opacity?: number;
  class?: string;
  /** Center hexes spell this word (e.g. Volleier) with dissolve spray. */
  logoText?: string;
  logoColor?: string;
  logoScale?: number;
  /** 0..1 fills the hex bar. Negative hides it. */
  progress?: number;
  /** Bar width as a fraction of the word box width. */
  barWidth?: number;
  /** 0..1 completion: flash, word sweep, then cell dissolve. */
  outro?: number;
}

const {
  zIndex = 1,
  preset = 'swell',
  color = '#A855F7',
  glintColor = '#FFFFFF',
  backgroundColor = 'transparent',
  scale = 0.9,
  speed,
  direction,
  chop,
  stretch,
  glint = 0.9,
  contrast = 1.7,
  perspective,
  fog,
  slatWidth = 8,
  slatHeight = 22,
  gap = 3,
  roundness = 0.75,
  interactive = true,
  cursorStrength = 1,
  cursorSize = 36,
  swirl = 0.8,
  trail = 1.4,
  lean = 1.0,
  intro = true,
  introDuration = 1.8,
  followTheme = true,
  paused = false,
  opacity = 1,
  class: className = '',
  logoText = '',
  logoColor = '#00ffe2',
  logoScale = 1,
  progress = -1,
  barWidth = 0.62,
  outro = 0,
} = Astro.props;

import '../../../styles/components/effects/slat-ocean.scss';

const containerClass = ['slat-ocean-container', className].filter(Boolean).join(' ');
---

<div
  class={containerClass}
  style={`z-index: ${zIndex}; opacity: ${opacity};`}
  data-follow-theme={followTheme ? 'true' : 'false'}
  data-paused={paused ? 'true' : 'false'}
>
  <canvas
    class="slat-ocean-canvas"
    data-preset={preset}
    data-color={color}
    data-glint-color={glintColor}
    data-background-color={backgroundColor}
    data-scale={scale !== undefined ? String(scale) : ''}
    data-speed={speed !== undefined ? String(speed) : ''}
    data-direction={direction !== undefined ? String(direction) : ''}
    data-chop={chop !== undefined ? String(chop) : ''}
    data-stretch={stretch !== undefined ? String(stretch) : ''}
    data-glint={glint !== undefined ? String(glint) : ''}
    data-contrast={contrast !== undefined ? String(contrast) : ''}
    data-perspective={perspective !== undefined ? String(perspective) : ''}
    data-fog={fog !== undefined ? String(fog) : ''}
    data-slat-w={slatWidth !== undefined ? String(slatWidth) : ''}
    data-slat-h={slatHeight !== undefined ? String(slatHeight) : ''}
    data-gap={gap !== undefined ? String(gap) : ''}
    data-roundness={roundness !== undefined ? String(roundness) : ''}
    data-interactive={interactive ? 'true' : 'false'}
    data-cursor-strength={cursorStrength !== undefined ? String(cursorStrength) : ''}
    data-cursor-size={cursorSize !== undefined ? String(cursorSize) : ''}
    data-swirl={swirl !== undefined ? String(swirl) : ''}
    data-trail={trail !== undefined ? String(trail) : ''}
    data-lean={lean !== undefined ? String(lean) : ''}
    data-intro={intro ? 'true' : 'false'}
    data-intro-duration={introDuration !== undefined ? String(introDuration) : ''}
    data-logo-text={logoText || ''}
    data-logo-color={logoColor}
    data-logo-scale={logoScale !== undefined ? String(logoScale) : ''}
    data-progress={progress !== undefined ? String(progress) : ''}
    data-bar-width={barWidth !== undefined ? String(barWidth) : ''}
    data-outro={outro !== undefined ? String(outro) : ''}
  ></canvas>
</div>

<script>
  function initSlatOceanExact() {
    const canvases = document.querySelectorAll('.slat-ocean-canvas') as NodeListOf<HTMLCanvasElement>;

    canvases.forEach((canvas) => {
      if ((canvas as any)._zV_initialized) return;
      (canvas as any)._zV_initialized = true;

      const gl = canvas.getContext('webgl2', {
        alpha: true,
        antialias: false,
        depth: false,
        stencil: false,
        powerPreference: 'high-performance',
      }) as WebGL2RenderingContext | null;

      if (!gl) {
        console.warn('WebGL2 not supported');
        return;
      }

      // 1:1 Presets & Constants from zV
      const BT: Record<string, any> = {
        swell: { scale: 1.5, speed: 0.6, direction: 250, chop: 0.55, stretch: 0, glint: 0.7, contrast: 1.25, perspective: 0.55, fog: 0.55 },
        tide:  { scale: 1.3, speed: 0.5, direction: 262, chop: 0.2, stretch: 0.12, glint: 0.45, contrast: 1.1, perspective: 0.5, fog: 0.4 },
        storm: { scale: 0.55, speed: 1.6, direction: 236, chop: 1, stretch: 0.3, glint: 1.3, contrast: 1.8, perspective: 0.8, fog: 0.35 },
        signal:{ scale: 0.85, speed: 1.2, direction: 180, chop: 0.6, stretch: 0.85, glint: 0.25, contrast: 1.2, perspective: 0, fog: 0 },
      };

      const Np = 96;
      const Y0e = 16;
      const nv = 6900;
      const _T = 3;
      const W0e = 45e5;

      const di = (e: number, t: number, n: number) => Math.min(Math.max(e, t), n);

      const iv = (e: string, t: [number, number, number, number]): [number, number, number, number] => {
        try {
          const n = document.createElement('canvas').getContext('2d');
          if (!n) return t;
          n.fillStyle = '#000000';
          n.fillStyle = e;
          const i = n.fillStyle;
          if (i.startsWith('#')) {
            const l = parseInt(i.slice(1), 16);
            return [((l >> 16) & 255) / 255, ((l >> 8) & 255) / 255, (l & 255) / 255, 1];
          }
          const r = i.match(/[\d.]+/g);
          return !r || r.length < 3
            ? t
            : [Number(r[0]) / 255, Number(r[1]) / 255, Number(r[2]) / 255, r[3] ? Number(r[3]) : 1];
        } catch {
          return t;
        }
      };

      // Read props from dataset with fallback to zV defaults
      const container = (canvas.closest('.slat-ocean-container') as HTMLElement) || canvas.parentElement || canvas;
      const presetKey = canvas.dataset.preset || 'swell';
      const q = BT[presetKey] || BT.swell;
      const H = (val: string | undefined, key: string) =>
        val !== undefined && val !== '' ? parseFloat(val) : q[key];

      const followTheme = container.dataset.followTheme !== 'false';
      const color = iv(canvas.dataset.color || '#A855F7', [0.659, 0.333, 0.969, 1]);
      const glintColor = iv(canvas.dataset.glintColor || '#FFFFFF', [1, 1, 1, 1]);
      const backgroundColor = iv(canvas.dataset.backgroundColor || 'transparent', [0, 0, 0, 0]);

      const props = {
        preset: presetKey,
        color,
        glintColor,
        backgroundColor,
        followTheme,
        slatWidth: parseFloat(canvas.dataset.slatW || '8') || 8,
        slatHeight: parseFloat(canvas.dataset.slatH || '22') || 22,
        gap: parseFloat(canvas.dataset.gap || '3') || 3,
        roundness: parseFloat(canvas.dataset.roundness || '0.75') || 0.75,
        scale: H(canvas.dataset.scale, 'scale'),
        speed: H(canvas.dataset.speed, 'speed'),
        direction: H(canvas.dataset.direction, 'direction'),
        chop: H(canvas.dataset.chop, 'chop'),
        stretch: H(canvas.dataset.stretch, 'stretch'),
        glint: H(canvas.dataset.glint, 'glint'),
        contrast: H(canvas.dataset.contrast, 'contrast'),
        perspective: H(canvas.dataset.perspective, 'perspective'),
        fog: H(canvas.dataset.fog, 'fog'),
        interactive: canvas.dataset.interactive !== 'false',
        cursorStrength: parseFloat(canvas.dataset.cursorStrength || '1') || 1,
        cursorSize: parseFloat(canvas.dataset.cursorSize || '36') || 36,
        swirl: parseFloat(canvas.dataset.swirl || '0.8') || 0.8,
        trail: parseFloat(canvas.dataset.trail || '1.4') || 1.4,
        lean: parseFloat(canvas.dataset.lean || '1.0') || 1.0,
        intro: canvas.dataset.intro !== 'false',
        introDuration: parseFloat(canvas.dataset.introDuration || '1.8') || 1.8,
        logoText: (canvas.dataset.logoText || '').trim(),
        logoColor: iv(canvas.dataset.logoColor || '#00ffe2', [0, 1, 0.886, 1]),
        logoScale: parseFloat(canvas.dataset.logoScale || '1') || 1,
        progress: canvas.dataset.progress === undefined || canvas.dataset.progress === ''
          ? -1
          : parseFloat(canvas.dataset.progress),
        barWidth: parseFloat(canvas.dataset.barWidth || '0.62') || 0.62,
        outro: parseFloat(canvas.dataset.outro || '0') || 0,
      };

      // Shaders (1:1 identical to zV source)
      const OT = `#version 300 es
in vec2 position;
void main() {
  gl_Position = vec4(position, 0.0, 1.0);
}
`;

      const q0e = `#version 300 es
in vec2 position;
uniform vec2 uTexel;
out vec2 vUv;
out vec2 vL;
out vec2 vR;
out vec2 vT;
out vec2 vB;
void main() {
  vUv = position * 0.5 + 0.5;
  vL = vUv - vec2(uTexel.x, 0.0);
  vR = vUv + vec2(uTexel.x, 0.0);
  vT = vUv + vec2(0.0, uTexel.y);
  vB = vUv - vec2(0.0, uTexel.y);
  gl_Position = vec4(position, 0.0, 1.0);
}
`;

      const xs = `#version 300 es
precision highp float;
in vec2 vUv;
in vec2 vL;
in vec2 vR;
in vec2 vT;
in vec2 vB;
out vec4 fragColor;
`;

      const Z0e = `${xs}
uniform sampler2D uTarget;
uniform float uAspect;
uniform vec2 uPoint;
uniform vec3 uValue;
uniform float uRadius;
void main() {
  vec2 offset = vUv - uPoint;
  offset.x *= uAspect;
  float falloff = exp(-dot(offset, offset) / uRadius);
  fragColor = vec4(texture(uTarget, vUv).xyz + uValue * falloff, 1.0);
}
`;

      const X0e = `${xs}
uniform sampler2D uVelocity;
void main() {
  float left = texture(uVelocity, vL).y;
  float right = texture(uVelocity, vR).y;
  float top = texture(uVelocity, vT).x;
  float bottom = texture(uVelocity, vB).x;
  fragColor = vec4(0.5 * (right - left - top + bottom), 0.0, 0.0, 1.0);
}
`;

      const Q0e = `${xs}
uniform sampler2D uVelocity;
uniform sampler2D uCurl;
uniform float uSwirl;
uniform float uDt;
void main() {
  float left = texture(uCurl, vL).x;
  float right = texture(uCurl, vR).x;
  float top = texture(uCurl, vT).x;
  float bottom = texture(uCurl, vB).x;
  float middle = texture(uCurl, vUv).x;
  vec2 force = 0.5 * vec2(abs(top) - abs(bottom), abs(right) - abs(left));
  force = force / (length(force) + 0.0001) * uSwirl * middle;
  force.y = -force.y;
  vec2 velocity = texture(uVelocity, vUv).xy + force * uDt;
  fragColor = vec4(clamp(velocity, -1000.0, 1000.0), 0.0, 1.0);
}
`;

      const J0e = `${xs}
uniform sampler2D uVelocity;
void main() {
  vec2 middle = texture(uVelocity, vUv).xy;
  float left = vL.x < 0.0 ? -middle.x : texture(uVelocity, vL).x;
  float right = vR.x > 1.0 ? -middle.x : texture(uVelocity, vR).x;
  float top = vT.y > 1.0 ? -middle.y : texture(uVelocity, vT).y;
  float bottom = vB.y < 0.0 ? -middle.y : texture(uVelocity, vB).y;
  fragColor = vec4(0.5 * (right - left + top - bottom), 0.0, 0.0, 1.0);
}
`;

      const ebe = `${xs}
uniform sampler2D uPressure;
uniform sampler2D uDivergence;
void main() {
  float left = texture(uPressure, vL).x;
  float right = texture(uPressure, vR).x;
  float top = texture(uPressure, vT).x;
  float bottom = texture(uPressure, vB).x;
  float divergence = texture(uDivergence, vUv).x;
  fragColor = vec4((left + right + top + bottom - divergence) * 0.25, 0.0, 0.0, 1.0);
}
`;

      const tbe = `${xs}
uniform sampler2D uPressure;
uniform sampler2D uVelocity;
void main() {
  float left = texture(uPressure, vL).x;
  float right = texture(uPressure, vR).x;
  float top = texture(uPressure, vT).x;
  float bottom = texture(uPressure, vB).x;
  vec2 velocity = texture(uVelocity, vUv).xy - vec2(right - left, top - bottom);
  fragColor = vec4(velocity, 0.0, 1.0);
}
`;

      const nbe = `${xs}
uniform sampler2D uVelocity;
uniform sampler2D uSource;
uniform vec2 uTexel;
uniform float uDt;
uniform float uFade;
void main() {
  vec2 from = vUv - uDt * texture(uVelocity, vUv).xy * uTexel;
  fragColor = texture(uSource, from) / (1.0 + uFade * uDt);
}
`;

      const ibe = `${xs}
uniform sampler2D uSource;
uniform float uValue;
void main() {
  fragColor = texture(uSource, vUv) * uValue;
}
`;

      // Word scatter field: xy = displacement (fraction of height, uv space), z = disturbance
      const sbe = `${xs}
uniform sampler2D uVelocity;
uniform sampler2D uSource;
uniform vec2 uTexel;
uniform float uDt;
uniform float uDecay;
void main() {
  vec2 from = vUv - uDt * texture(uVelocity, vUv).xy * uTexel * 0.6;
  vec4 s = texture(uSource, from) * exp(-uDecay * uDt);
  vec2 d = s.xy;
  float l = length(d);
  if (l > 0.3) d *= 0.3 / l;
  fragColor = vec4(d, clamp(s.z, 0.0, 1.2), 1.0);
}
`;

      const rbe = `#version 300 es
precision highp float;
uniform vec2 uSize;
uniform vec4 uGrid;
uniform vec2 uOrigin;
uniform vec2 uSlat;
uniform float uTime;
uniform float uScale;
uniform float uDirection;
uniform float uChop;
uniform float uStretch;
uniform float uGlint;
uniform float uContrast;
uniform float uPerspective;
uniform float uFog;
uniform float uIntro;
uniform sampler2D tVelocity;
uniform sampler2D tInk;
uniform sampler2D tLogo;
uniform sampler2D tScatter;
uniform float uScatter;
uniform vec2 uFluidTexel;
uniform float uFluid;
uniform float uInk;
uniform float uLean;
uniform float uLogo;
uniform vec2 uLogoBox;
uniform float uProgress;
uniform vec4 uBar;
uniform float uOutro;
out vec4 fragColor;

float hash21(vec2 p) {
  return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);
}

float noise(vec2 p) {
  vec2 i = floor(p);
  vec2 f = fract(p);
  f = f * f * (3.0 - 2.0 * f);
  float a = hash21(i);
  float b = hash21(i + vec2(1.0, 0.0));
  float c = hash21(i + vec2(0.0, 1.0));
  float d = hash21(i + vec2(1.0, 1.0));
  return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

float fbm(vec2 p) {
  float v = 0.0;
  float a = 0.5;
  mat2 m = mat2(0.80, -0.60, 0.60, 0.80);
  for (int i = 0; i < 5; i++) {
    v += a * noise(p);
    p = m * p * 2.05;
    a *= 0.5;
  }
  return v;
}

vec2 hexCenter(float col, float row) {
  return uOrigin + vec2(col * uGrid.z + mod(row, 2.0) * uGrid.z * 0.5, row * uGrid.w);
}

// x = solid letter cells, y = faint halo that dissolves outward (no rings, no offset copy)
vec2 wordMask(vec2 center, float t) {
  if (uLogo < 0.5) return vec2(0.0);
  vec2 luv = (center - uSize * 0.5) / max(uLogoBox, vec2(1.0)) + 0.5;
  if (luv.x < -0.05 || luv.y < -0.05 || luv.x > 1.05 || luv.y > 1.05) return vec2(0.0);
  vec2 cuv = clamp(luv, 0.0, 1.0);
  float n = noise(center * 0.045 + vec2(t * 0.35, -t * 0.28));
  float n2 = noise(center * 0.12 - vec2(t * 0.5, t * 0.42));
  float core = smoothstep(0.42, 0.62, texture(tLogo, cuv).r + (n - 0.5) * 0.1);
  float soft = textureLod(tLogo, cuv, 4.0).r;
  float wide = textureLod(tLogo, cuv, 6.0).r;
  float halo = clamp(soft * 1.1 + wide * 1.4, 0.0, 1.0);
  float grain = smoothstep(0.3, 0.85, n2 * 0.6 + n * 0.4);
  halo *= (0.5 + 0.5 * grain) * (1.0 - core);
  return vec2(core, halo);
}

void main() {
  vec2 cell = floor(gl_FragCoord.xy);
  float row = uGrid.y - 1.0 - cell.y;
  vec2 center = hexCenter(cell.x, row);
  float v = clamp(center.y / uSize.y, 0.0, 1.0);

  vec2 flow = vec2(0.0);
  float ink = 0.0;
  if (uFluid > 0.5) {
    vec2 fluidUv = clamp(vec2(center.x / uSize.x, 1.0 - center.y / uSize.y), 0.0, 1.0);
    flow = texture(tVelocity, fluidUv).xy * uFluidTexel * uSize;
    ink = texture(tInk, fluidUv).x;
  }

  float horizon = mix(8.0, 0.5, uPerspective);
  float depth = (1.0 + horizon) / (v + horizon);
  vec2 world = vec2((center.x - uSize.x * 0.5) / uSize.y * depth, (depth - 1.0) * horizon * 2.2);
  world -= flow * 0.00018 * depth;
  world /= max(uScale, 0.05);

  float t = uTime;
  vec2 drift = vec2(
    fbm(world * 0.20 + vec2(t * 0.38, -t * 0.29)) - 0.5,
    fbm(world * 0.20 + vec2(3.1, 7.7) + vec2(-t * 0.33, t * 0.42)) - 0.5
  );
  vec2 swirl = vec2(
    fbm(world.yx * 0.32 + t * 0.22) - 0.5,
    fbm(world.xy * 0.32 - t * 0.24 + 2.4) - 0.5
  );
  vec2 q = world + drift * 2.4 + swirl * (1.0 + uChop * 0.4);

  float n1 = fbm(q * 0.48 + t * 0.28);
  float n2 = fbm(q * 0.95 - t * 0.33 + vec2(9.2, -4.1));
  float n3 = fbm(q * 1.7 + vec2(n1, n2) * 0.7 + t * 0.40);
  float height = (n1 * 1.25 + n2 * 0.8 + n3 * (0.4 + uChop * 0.45)) / (2.45 + uChop * 0.45);
  // Stretch midtones so trough / crest stay readable after contrast
  float level = clamp(smoothstep(0.08, 0.92, height) * 1.08, 0.0, 1.0);
  float crest = smoothstep(0.52, 1.0, level);
  float glint = crest * crest * max(uGlint, 0.22);

  float haze = mix(1.0, 1.0 - uFog * 0.75, pow(1.0 - v, 1.25));
  // Floor + shaped contrast: waves stay visible, crests still punchy
  float shaped = pow(level, mix(1.15, uContrast, 0.72));
  float light = (0.14 + 0.86 * shaped + glint * 0.55) * haze;
  float glow = 1.0 - exp(-max(ink, 0.0) * uInk * 1.6);
  light = 1.0 - (1.0 - clamp(light, 0.0, 1.0)) * (1.0 - glow);
  light = max(light, 0.1);

  // No top-to-bottom intro wipe when uIntro is already 1.
  float reveal = 1.0;
  float sweep = 0.0;
  if (uIntro < 0.999) {
    float front = uIntro * 1.35;
    reveal = 1.0 - smoothstep(front - 0.35, front, v);
    sweep = exp(-pow((v - front + 0.22) / 0.07, 2.0)) * (1.0 - uIntro);
    light = (light + sweep * 0.8) * reveal;
    light = max(light, 0.045 * reveal);
  }

  // Bright hex cells that spell the word (mask only — not a drawn logo).
  vec2 dispCell = vec2(0.0);
  float scAmt = 0.0;
  float h1 = hash21(cell + 3.7);
  if (uScatter > 0.5 && uLogo > 0.5) {
    vec4 s = texture(tScatter, clamp(vec2(center.x / uSize.x, 1.0 - center.y / uSize.y), 0.0, 1.0));
    scAmt = clamp(s.z, 0.0, 1.0);
    float ang = hash21(cell + 17.3) * 6.2832;
    vec2 jitter = vec2(cos(ang), sin(ang)) * scAmt * uSlat.x * 7.0 * h1;
    dispCell = vec2(s.x, -s.y) * uSize.y * (0.55 + 0.9 * h1) + jitter;
  }
  vec2 wm = wordMask(center - dispCell, t);
  float keep = 1.0 - (1.0 - smoothstep(scAmt * 0.7 - 0.08, scAmt * 0.7 + 0.08, h1)) * smoothstep(0.02, 0.15, scAmt);
  wm *= keep;
  float halo = wm.y * 0.75;
  light = max(light, wm.x * 0.98);
  light = 1.0 - (1.0 - clamp(light, 0.0, 1.0)) * (1.0 - halo);
  float word = max(wm.x, halo * 0.8);
  float span = mix(1.0 - uStretch, 1.0, level) + glow * 0.3;
  span = clamp(span, 0.08, 1.0) * mix(0.1, 1.0, reveal);
  span = mix(span, max(span, 0.92), wm.x);
  float tint = clamp(smoothstep(0.2, 0.85, level) * 0.9 + crest * 0.35 + glow * 0.85 + sweep, 0.0, 1.0);
  float lean = clamp(length(flow) > 0.001 ? flow.x / 1400.0 : (drift.x - drift.y) * 0.45, -1.0, 1.0) * uLean * reveal;

  // Hex progress bar under the word. Uses cell centers, so scatter cannot move it.
  if (uProgress >= 0.0) {
    float bx = (center.x - (uBar.x - uBar.z)) / max(uBar.z * 2.0, 1.0);
    float by = abs(center.y - uBar.y) / max(uBar.w, 1.0);
    if (by < 1.0 && bx > -0.02 && bx < 1.02) {
      light = max(light, 0.28);
      word = max(word, 0.22);
      if (bx < uProgress) {
        light = max(light, 0.98);
        word = 1.0;
        span = max(span, 0.92);
      }
      float head = exp(-pow((bx - uProgress) * 28.0, 2.0));
      head *= step(0.02, uProgress) * (1.0 - step(0.995, uProgress));
      float flick = 0.6 + 0.4 * noise(vec2(floor(bx * 48.0), t * 5.0));
      light = max(light, head * flick);
      word = max(word, head * 0.85);
