---
import GildedEffect from '../effects/GildedEffect.astro';
import SlatOceanEffect from '../effects/SlatOceanEffect.astro';
import '../../../styles/components/loading-screen.scss';

// Temporary pin so hex loading can be reviewed; set false for normal load → home.
const PIN_HEX_LOADING = true;
---

{PIN_HEX_LOADING && (
  <style is:inline>
    #loading-screen { display: block !important; opacity: 1 !important; visibility: visible !important; }
  </style>
)}

<div
  id="loading-screen"
  class="loading-overlay loading-overlay--hex-only"
  data-pin-hex={PIN_HEX_LOADING ? 'true' : 'false'}
>
  <!-- Locked cyan honeycomb look (from tuned debug snapshot) -->
  <SlatOceanEffect
    zIndex={1}
    preset="swell"
    scale={0.2}
    speed={1}
    contrast={2.2}
    glint={0.25}
    chop={0.8}
    stretch={0}
    perspective={1}
    fog={0.45}
    slatWidth={10}
    slatHeight={10}
    gap={1.5}
    cursorSize={85}
    intro={false}
    followTheme={false}
    color="#00FFCC"
    glintColor="#0088FF"
    backgroundColor="transparent"
    interactive={true}
    logoText="Volleier"
    logoColor="#00ffe2"
    logoScale={1}
    progress={0}
    barWidth={0.62}
    outro={0}
  />

  <!-- Original chrome kept in DOM for timing/morph, visually hidden in hex-only mode -->
  <div class="serif serif-top"></div>
  <div class="serif serif-bottom"></div>
  <div class="serif serif-left"></div>
  <div class="serif serif-right"></div>
  <div class="loading-watermark">VOLLEIER</div>

  <div class="name-block-outer">
    <div class="name-tech-card">
      <div class="card-bracket bracket-tl"></div>
      <div class="card-bracket bracket-br"></div>
      <div class="card-header">
        <span class="card-tag">SYS.ID // CORE</span>
        <span class="card-status-dot"></span>
      </div>
      <div class="name-images">
        <div class="name-zh-wrapper">
          <img src="/assets/loading/PengLaiSiShaoXiao.png" alt="PengLaiSiShaoXiao" class="name-zh" />
        </div>
        <div class="white-separator-container">
          <div class="white-separator"></div>
        </div>
        <img src="/assets/loading/Volleier.png" alt="Volleier" class="name-en" />
      </div>
    </div>
  </div>

  <div class="status-bar-container">
    <div class="progress-panel">
      <div class="progress-meta">
        <div class="meta-left">
          <span class="meta-icon">▶</span>
          <span class="meta-label">SYS.LOADER // ASSET_INITIALIZATION</span>
        </div>
        <div class="meta-right">
          <span class="meta-percent" id="loading-percent">000%</span>
        </div>
      </div>
      <div class="loading-bar-wrapper">
        <div class="loading-bar">
          <GildedEffect zIndex={1} />
        </div>
        <div class="magenta-line"></div>
      </div>
    </div>
  </div>
</div>

<script>
  const homepageAssets = [
    '/assets/default/DefaultPage.webp',
    '/assets/default/PengLaiSiShaoXiao-Logo.webp',
  ];

  function preloadHomepageAssets() {
    return Promise.all(
      homepageAssets.map(
        (src) =>
          new Promise((resolve) => {
            const image = new Image();
            image.decoding = 'async';
            image.fetchPriority = 'high';
            image.onload = async () => {
              try {
                await image.decode();
              } catch {}
              resolve();
            };
            image.onerror = resolve;
            image.src = src;
          })
      )
    );
  }

  function runHexLoad(loadingScreen: HTMLElement) {
    const canvas = loadingScreen.querySelector('.slat-ocean-canvas') as HTMLCanvasElement | null;
    const pinned = loadingScreen.dataset.pinHex === 'true';
    const MIN_MS = 3000;
    const OUTRO_MS = 1400;
    let imageScore = homepageAssets.length === 0 ? 1 : 0;
    let fontScore = 0;
    let loadScore = document.readyState === 'complete' ? 1 : 0;

    const total = Math.max(1, homepageAssets.length);
    let imagesDone = 0;
    homepageAssets.forEach((src) => {
      const image = new Image();
      const done = () => {
        imagesDone += 1;
        imageScore = imagesDone / total;
      };
      image.decoding = 'async';
      image.onload = () => {
        image.decode().then(done, done);
      };
      image.onerror = done;
      image.src = src;
    });

    const fonts = (document as Document & { fonts?: { ready: Promise<unknown> } }).fonts;
    if (fonts?.ready) fonts.ready.then(() => { fontScore = 1; }, () => { fontScore = 1; });
    else fontScore = 1;

    if (loadScore < 1) {
      window.addEventListener('load', () => { loadScore = 1; }, { once: true });
    }

    const realReady = () => imageScore * 0.6 + fontScore * 0.15 + loadScore * 0.25 >= 0.999;

    let start = 0;
    let mode: 'curve' | 'wait' | 'fill' | 'outro' | 'hold' = 'curve';
    let fillFrom = 0;
    let mark = 0;
    let shown = 0;
    let outro = 0;

    const push = () => {
      const api = (canvas as HTMLCanvasElement & { _zV?: { apply: (p: Record<string, number>) => void } })?._zV;
      if (api) api.apply({ progress: shown, outro });
    };

    const finish = () => {
      loadingScreen.classList.add('fade-out');
      document.dispatchEvent(new CustomEvent('LoadingSequenceMorph'));
      window.setTimeout(() => {
        loadingScreen.style.display = 'none';
        document.dispatchEvent(new CustomEvent('LoadingScreenComplete'));
      }, 800);
    };

    const tick = (now: number) => {
      const elapsed = now - start;
      const t = Math.min(1, Math.max(0, elapsed / MIN_MS));
      const eased = 1 - Math.pow(1 - t, 3);
      const ready = realReady();

      if (mode === 'curve') {
        shown = eased * (ready ? 1 : 0.92);
        outro = 0;
        if (elapsed >= MIN_MS) {
          if (ready && shown >= 0.999) {
            shown = 1;
            mode = 'outro';
            mark = now;
          } else if (ready) {
            fillFrom = shown;
            mode = 'fill';
            mark = now;
          } else {
            mode = 'wait';
          }
        }
      } else if (mode === 'wait') {
        shown = Math.min(0.97, 0.92 + (elapsed - MIN_MS) / 1000 * 0.015);
        if (ready) {
          fillFrom = shown;
          mode = 'fill';
          mark = now;
        }
      } else if (mode === 'fill') {
        const u = Math.min(1, (now - mark) / 200);
        shown = fillFrom + (1 - fillFrom) * u;
        if (u >= 1) {
          shown = 1;
          mode = 'outro';
          mark = now;
        }
      } else if (mode === 'outro') {
        shown = 1;
        outro = Math.min(1, (now - mark) / OUTRO_MS);
        if (outro >= 1) {
          if (pinned) {
            mode = 'hold';
            mark = now;
          } else {
            push();
            finish();
            return;
          }
        }
      } else if (mode === 'hold') {
        shown = 1;
        outro = 1;
        if (now - mark > 500) {
          start = now;
          shown = 0;
          outro = 0;
          mode = 'curve';
        }
      }

      push();
      requestAnimationFrame(tick);
    };

    const boot = () => {
      const api = (canvas as HTMLCanvasElement & { _zV?: unknown })?._zV;
      if (!api) {
        requestAnimationFrame(boot);
        return;
      }
      start = performance.now();
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(boot);
  }

  async function startLoadingTimer() {
    const loadingScreen = document.getElementById('loading-screen');
    const nameZh = document.querySelector('.name-zh');
    if (!loadingScreen) return;

    if (document.documentElement.dataset.skipLoadingScreen === 'true') {
      document.dispatchEvent(new CustomEvent('LoadingSequenceMorph'));
      document.dispatchEvent(new CustomEvent('LoadingScreenComplete'));
      return;
    }

    if (loadingScreen.classList.contains('loading-overlay--hex-only')) {
      runHexLoad(loadingScreen);
      return;
    }

    const startTime = performance.now();
    const duration = 2400;
    const percentElem = document.getElementById('loading-percent');
    let animFrame = 0;

    function updatePercent(now: number) {
      const elapsed = (now - startTime) / duration;
      const t = Math.min(1.0, Math.max(0.0, elapsed));
      const progress = 1.0 - Math.pow(1.0 - t, 4.0);
      const pct = Math.floor(progress * 100);
      if (percentElem) {
        percentElem.textContent = `${String(pct).padStart(3, '0')}%`;
      }
      if (t < 1.0) {
        animFrame = requestAnimationFrame(updatePercent);
      }
    }
    animFrame = requestAnimationFrame(updatePercent);

    if (loadingScreen.dataset.pinHex === 'true') {
      return;
    }

    await preloadHomepageAssets();

    const hardTimeout = window.setTimeout(() => {
      loadingScreen.style.display = 'none';
      document.dispatchEvent(new CustomEvent('LoadingSequenceMorph'));
      document.dispatchEvent(new CustomEvent('LoadingScreenComplete'));
    }, 5500);

    // Hex-only: skip cinematic chrome morph; fade straight to home.
    if (loadingScreen.classList.contains('loading-overlay--hex-only')) {
      window.setTimeout(() => {
        loadingScreen.classList.add('fade-out');
        document.dispatchEvent(new CustomEvent('LoadingSequenceMorph'));
        window.clearTimeout(hardTimeout);
        window.setTimeout(() => {
          loadingScreen.style.display = 'none';
          document.dispatchEvent(new CustomEvent('LoadingScreenComplete'));
        }, 800);
      }, 2600);
      return;
    }

    if (!nameZh) {
      setTimeout(() => {
        loadingScreen.style.display = 'none';
        window.clearTimeout(hardTimeout);
        document.dispatchEvent(new CustomEvent('LoadingSequenceMorph'));
        document.dispatchEvent(new CustomEvent('LoadingScreenComplete'));
      }, 2000);
      return;
    }

    setTimeout(() => {
      const nameWrapper = document.querySelector('.name-zh-wrapper');
      if (nameWrapper) {
        const lockLineHLeft = document.createElement('div');
        const lockLineHRight = document.createElement('div');
        const lockLineVTop = document.createElement('div');
        const lockLineVBottom = document.createElement('div');

        lockLineHLeft.className = 'cinematic-lock-line line-h-left';
        lockLineHRight.className = 'cinematic-lock-line line-h-right';
        lockLineVTop.className = 'cinematic-lock-line line-v-top';
        lockLineVBottom.className = 'cinematic-lock-line line-v-bottom';

        nameWrapper.appendChild(lockLineHLeft);
        nameWrapper.appendChild(lockLineHRight);
        nameWrapper.appendChild(lockLineVTop);
        nameWrapper.appendChild(lockLineVBottom);

        requestAnimationFrame(() => {
          setTimeout(() => {
            lockLineHLeft.classList.add('fire');
            lockLineHRight.classList.add('fire');
            lockLineVTop.classList.add('fire');
            lockLineVBottom.classList.add('fire');
          }, 20);
        });
      }

      setTimeout(() => {
        const rect = nameZh.getBoundingClientRect();

        const flightWrapper = document.createElement('div');
        flightWrapper.className = 'flight-wrapper';
        flightWrapper.style.top = `${rect.top}px`;
        flightWrapper.style.left = `${rect.left}px`;
        flightWrapper.style.width = `${rect.width}px`;
        flightWrapper.style.height = `${rect.height}px`;

        const flyImg = document.createElement('img');
        flyImg.src = nameZh instanceof HTMLImageElement ? nameZh.src : '';
        flyImg.className = 'fly-img';

        const flyHLeft = document.createElement('div');
        flyHLeft.className = 'fly-lock line-h-left';
        const flyHRight = document.createElement('div');
        flyHRight.className = 'fly-lock line-h-right';
        const flyVTop = document.createElement('div');
        flyVTop.className = 'fly-lock line-v-top';
        const flyVBottom = document.createElement('div');
        flyVBottom.className = 'fly-lock line-v-bottom';

        flightWrapper.appendChild(flyImg);
        flightWrapper.appendChild(flyHLeft);
        flightWrapper.appendChild(flyHRight);
        flightWrapper.appendChild(flyVTop);
        flightWrapper.appendChild(flyVBottom);
        document.body.appendChild(flightWrapper);

        loadingScreen.classList.add('cinematic-disintegrate');
        void flightWrapper.offsetWidth;

        const destLeft = window.innerWidth / 2 - rect.width / 2;
        const destTop = window.innerHeight / 2 - rect.height / 2;
        flightWrapper.style.transform = `translate(${destLeft - rect.left}px, ${destTop - rect.top}px)`;

        setTimeout(() => {
          flightWrapper.classList.add('morph-fade');
          document.dispatchEvent(new CustomEvent('LoadingSequenceMorph'));
          window.clearTimeout(hardTimeout);
          setTimeout(() => {
            loadingScreen.style.display = 'none';
            flightWrapper.remove();
            document.dispatchEvent(new CustomEvent('LoadingScreenComplete'));
          }, 600);
        }, 1000);
      }, 600);
    }, 2400);
  }

  startLoadingTimer();
</script>
