---
const { 
  title = 'Volleier', 
  description = '', 
  ogImage = '',
  preloadImage = '',
  preloadImages = [],
  showNav = true,
  showFooter = true,
  showLoading = false
} = Astro.props;
import '../styles/global.scss';
import Nav from '../components/ui/common/Nav.astro';
import Footer from '../components/ui/common/Footer.astro';
import LoadingScreen from '../components/ui/loading/LoadingScreen.astro';
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description ? <meta name="description" content={description} /> : null}
    <meta property="og:title" content={title} />
    {description ? <meta property="og:description" content={description} /> : null}
    {ogImage ? <meta property="og:image" content={ogImage} /> : null}
    {preloadImage ? <link rel="preload" as="image" href={preloadImage} type="image/webp" fetchpriority="high" /> : null}
    {preloadImages.map((image) => (
      <link rel="preload" as="image" href={image} type="image/webp" fetchpriority="high" />
    ))}
    {showLoading && (
      <script is:inline>
        (() => {
          const key = 'volleier:loading-screen-seen';
          try {
            if (window.localStorage.getItem(key) === '1') {
              document.documentElement.dataset.skipLoadingScreen = 'true';
            } else {
              window.localStorage.setItem(key, '1');
            }
          } catch {}
        })();
      </script>
    )}
  </head>
  <body class="min-h-screen flex flex-col">
    {showLoading && <LoadingScreen />}
    {showNav && <Nav />}
    <main class="flex-grow">
      <slot />
    </main>
    {showFooter && <Footer />}
  </body>
</html>
